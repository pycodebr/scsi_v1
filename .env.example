# =============================================================================
# SCSI — Template de variáveis de ambiente (seção 42 do PRD.md)
# Copie para `.env` e preencha com valores reais. NÃO versione o `.env`.
# =============================================================================

# --- Django core ---
DEBUG=False
SECRET_KEY=troque-esta-chave-em-producao
# Listas separadas por vírgula (lidas via django-environ). Use ponto inicial
# (.scsi.digital) para casar qualquer subdomínio.
ALLOWED_HOSTS=scsi.digital,.scsi.digital,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://scsi.digital,https://*.scsi.digital,http://localhost:8000,http://127.0.0.1:8000

# --- Localização ---
TIME_ZONE=America/Sao_Paulo
LANGUAGE_CODE=pt-br

# --- Banco de dados (PostgreSQL em prod/Docker; em dev local pode-se omitir
#     DATABASE_URL para cair no SQLite padrão) ---
DATABASE_URL=postgres://scsi:senha@db:5432/scsi
POSTGRES_DB=scsi
POSTGRES_USER=scsi
POSTGRES_PASSWORD=troque-esta-senha

# --- Celery / RabbitMQ / Redis (Sprint 2/3) ---
CELERY_BROKER_URL=amqp://scsi:senha@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0
RABBITMQ_DEFAULT_USER=scsi
RABBITMQ_DEFAULT_PASS=troque-esta-senha
REDIS_URL=redis://redis:6379/1

# --- IA / OpenAI (Sprint 21/22) ---
OPENAI_API_KEY=sk-troque-esta-chave
OPENAI_MODEL=gpt-5.5-mini

# --- E-mail / SMTP (Sprint 4) ---
EMAIL_HOST=smtp.provider.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@scsi.digital
EMAIL_HOST_PASSWORD=troque-esta-senha
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SCSI <no-reply@scsi.digital>

# --- Arquivos ---
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles

# --- Produção / Deploy (Sprint 27) ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
# E-mail usado pelo Let's Encrypt (Traefik) ao emitir o certificado.
ACME_EMAIL=admin@scsi.digital
# Domínio do projeto. Controla TUDO no Traefik via interpolação no docker-stack.yml:
#   - certificado TLS wildcard:  ${DOMAIN} e *.${DOMAIN}
#   - host do app:               Host(`${DOMAIN}`)
#   - host do dashboard:         Host(`traefik.${DOMAIN}`)
# Troque para o seu domínio. O docker stack deploy lê esta variável do ambiente
# (o deploy.sh / setup_deploy.sh carregam o .env antes de subir a stack).
DOMAIN=scsi.digital

# Basic Auth do dashboard do Traefik no formato "usuario:hash".
# Gere o hash com (instale antes: sudo apt install apache2-utils):
#   htpasswd -nbB admin 'SUA_SENHA'
# Cole a saída AQUI com UM cifrão ($) — NÃO duplique. O docker-stack.yml injeta
# via ${TRAEFIK_DASHBOARD_AUTH}, então não precisa de '$$'. Se ficar vazio, o
# stack usa um hash padrão de fallback. (O setup_deploy.sh preenche isto sozinho.)
TRAEFIK_DASHBOARD_AUTH=

# =============================================================================
# --- Monitoramento / Observabilidade (stack OPCIONAL: monitoring-stack.yml) ---
# =============================================================================
# Estas variáveis são usadas SOMENTE pela stack de monitoramento (Prometheus,
# Grafana, Loki). Elas NÃO afetam o deploy da aplicação. Suba a monitoria com
# ./scripts/setup_monitoring.sh (1ª vez) ou ./scripts/deploy_monitoring.sh.

# Subdomínio onde o Grafana será publicado (usa o wildcard TLS *.${DOMAIN}).
# Aponte um registro DNS (A/CNAME) de grafana.${DOMAIN} para o IP da VPS.
GRAFANA_DOMAIN=grafana.scsi.digital

# Credenciais do admin do Grafana (primeiro acesso). TROQUE a senha.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-esta-senha-do-grafana

# Retenção de métricas (Prometheus) e de logs (Loki).
# Loki exige duração em horas múltipla de 24h (360h = 15 dias).
PROMETHEUS_RETENTION=15d
LOKI_RETENTION=360h

# Prefixo das métricas do django-prometheus (ex.: scsi_django_http_requests_total).
# Precisa casar com o usado nos dashboards/alertas (variável "namespace" no Grafana).
PROMETHEUS_METRIC_NAMESPACE=scsi

# --- Servidor MCP do Grafana (grafana/mcp-grafana, OPCIONAL) ----------------
# Subdomínio onde o endpoint MCP será publicado via Traefik (TLS + Basic Auth).
# Aponte um registro DNS (A/CNAME) de mcp.${DOMAIN} para o IP da VPS.
# Clientes de IA conectam em: https://${MCP_DOMAIN}/mcp  (transporte streamable-http).
MCP_DOMAIN=mcp.scsi.digital

# Token de um Service Account do Grafana (Administration → Users and access →
# Service accounts → Add service account → Add token). É com ESTE token que o
# MCP opera o Grafana. Dê apenas as permissões necessárias (ex.: Viewer/Editor).
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_troque-pelo-token-do-service-account

# Usuários do Basic Auth do Traefik que protege o endpoint MCP (htpasswd).
# Gere com:  htpasswd -nbB usuario senha   (instale: apt-get install -y apache2-utils)
# Cole o hash EXATAMENTE como saiu, com "$" SIMPLES. Os scripts exportam o .env e
# o `docker stack deploy` injeta o valor verbatim via ${MCP_BASICAUTH_USERS} — então
# NÃO dobre o "$" (o "$$" só vale para "$" escrito DIRETO na stack, ex.: node-exporter).
# Ex.: admin:$2y$05$abcdefghijklmnopqrstuv...   (vários usuários separados por vírgula)
MCP_BASICAUTH_USERS=admin:$2y$05$troque.pelo.hash.gerado.com.htpasswd.bcrypt

# Diretório dos arquivos de config da monitoria (montados nos containers).
# Preenchido AUTOMATICAMENTE pelos scripts de monitoria (aponta para
# <repo>/monitoring). Só mexa se for rodar o `docker stack deploy` na mão.
MONITORING_CONFIG_DIR=

# --- Login com Google (django-allauth) — opcional ---
# Console: https://console.cloud.google.com/apis/credentials
# Callback: https://SEU-DOMINIO/social/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_SECRET=
# E-mails com acesso administrativo garantido via Google
STAFF_EMAILS=
